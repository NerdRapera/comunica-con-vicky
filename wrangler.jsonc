{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comunica-con-vicky",
  "workers_dev": true,
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "comunicaconvicky.com/*",
      "zone_name": "comunicaconvicky.com"
    },
    {
      "pattern": "www.comunicaconvicky.com/*",
      "zone_name": "comunicaconvicky.com"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
